<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle CORS headers if needed
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization"

  # Route /api/admin/* endpoints to api/admin.php
  RewriteRule ^api/admin/articles(/.*)?$ api/admin.php?action=articles [QSA,L]
  RewriteRule ^api/admin/products(/.*)?$ api/admin.php?action=products [QSA,L]
  RewriteRule ^api/admin/categories(/.*)?$ api/admin.php?action=categories [QSA,L]
  RewriteRule ^api/admin/settings(/.*)?$ api/admin.php?action=settings [QSA,L]
  RewriteRule ^api/admin/refresh-rate(/.*)?$ api/admin.php?action=refresh-rate [QSA,L]
  RewriteRule ^api/admin/multiplier-templates(/.*)?$ api/admin.php?action=multiplier-templates [QSA,L]
  RewriteRule ^api/admin(/.*)?$ api/admin.php [QSA,L]

  # Route public API endpoints to api/api.php
  RewriteRule ^api/articles(/.*)?$ api/api.php?action=articles [QSA,L]
  RewriteRule ^api/products(/.*)?$ api/api.php?action=products [QSA,L]
  RewriteRule ^api/categories(/.*)?$ api/api.php?action=categories [QSA,L]
  RewriteRule ^api/settings(/.*)?$ api/api.php?action=settings [QSA,L]

  # Fallback any other /api/* requests to api/api.php
  RewriteRule ^api/(.*)$ api/api.php?action=$1 [QSA,L]

  # SPA Routing: Redirect all non-file non-directory requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
